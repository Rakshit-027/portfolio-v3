{
  "name": "developer-portfolio",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next export",
    "analyze": "ANALYZE=true npm run build",
    "lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "seo-check": "next build && next start &amp; sleep 3 &amp;&amp; lighthouse http://localhost:3000 --only-categories=seo,accessibility,performance --output json --output-path ./seo-report.json"
  },
  "dependencies": {
    "@portabletext/react": "^3.1.0",
    "@sanity/client": "^6.29.1",
    "@sanity/icons": "^2.11.8",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^3.42.0",
    "axios": "^1.8.4",
    "framer-motion": "^11.0.8",
    "next": "^14.2.5",
    "next-sanity": "^7.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.0.1",
    "react-intersection-observer": "^9.8.1",
    "react-scroll": "^1.9.3",
    "resend": "^4.2.0",
    "sanity": "^3.42.0",
    "styled-components": "^6.1.19",
    "typed.js": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "24.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "typescript": "5.9.2"
  },
  "description": "A modern developer portfolio built with Next.js",
